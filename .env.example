# ═══ ỨNG DỤNG ═══
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_NAME=ShopVN
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ═══ DATABASE ═══
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ecommerce?schema=public

# ═══ REDIS (tùy chọn — bỏ trống thì dùng bộ nhớ trong) ═══
REDIS_URL=redis://localhost:6379

# ═══ JWT ═══  (sinh bằng: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=thay_bang_chuoi_hex_128_ky_tu_1
JWT_REFRESH_SECRET=thay_bang_chuoi_hex_128_ky_tu_2
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ═══ EMAIL ═══  (MAIL_DRIVER: smtp | resend | console)
MAIL_DRIVER=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ShopVN <no-reply@shop.vn>
RESEND_API_KEY=

# ═══ OAUTH ═══
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ═══ THANH TOÁN CHUYỂN KHOẢN ═══
BANK_BIN=970436
BANK_ACCOUNT_NO=0011000123456
BANK_ACCOUNT_NAME=NGUYEN VAN A
BANK_NAME=Vietcombank
WEBHOOK_SECRET=thay_bang_chuoi_bi_mat_webhook
ORDER_PAYMENT_TTL_MINUTES=1440
FREE_SHIPPING_THRESHOLD=500000
SHIPPING_FEE_STANDARD=30000
SHIPPING_FEE_EXPRESS=50000
SHIPPING_FEE_INSTANT=80000

# ═══ UPLOAD ═══
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
PUBLIC_UPLOAD_URL=http://localhost:4000/uploads

# ═══ BẢO MẬT ═══
BCRYPT_ROUNDS=12
SEED_ADMIN_EMAIL=admin@shop.vn
SEED_ADMIN_PASSWORD=Admin@123456
SEED_USER_EMAIL=customer@shop.vn
SEED_USER_PASSWORD=Customer@123456

# ── Chống spam / giới hạn tần suất (rate limit) ───────────────────────────────
# Ngưỡng chung cho toàn bộ API, tính theo từng IP trong mỗi khoảng thời gian.
# Để rộng rãi vì khi web gọi API qua proxy của Next.js, người dùng có thể bị
# tính chung một IP (xem mục TRUST_PROXY bên dưới).
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=2000
# Số lần thử đăng nhập tối đa cho mỗi IP + email trong 15 phút
RATE_LIMIT_LOGIN_MAX=10
# Số lớp proxy tin cậy — dùng để lấy IP thật của khách từ header X-Forwarded-For.
#   false = không tin proxy nào (an toàn nhất nếu API lộ trực tiếp ra internet)
#   1     = tin đúng proxy gần nhất (nginx, proxy rewrite của Next.js)  ← khuyến nghị
#   2, 3  = chuỗi nhiều lớp (CDN + nginx + app)
# Đừng đặt "true": giá trị đó bị quy về 1 lớp, và tư duy "tin mọi proxy" cho phép
# kẻ tấn công giả X-Forwarded-For để né rate limit.
TRUST_PROXY=1
