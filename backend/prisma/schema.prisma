// ════════════════════════════════════════════════════════════════════════════
//  ShopVN — Prisma schema
//  Nguyên tắc:
//   • Tiền dùng Decimal(12,2) — KHÔNG dùng Float (sai số làm tròn)
//   • Khoá chính cuid() — không lộ số lượng bản ghi, khó enumerate
//   • Xoá mềm (deletedAt) cho Product / User / Review
//   • OrderItem lưu SNAPSHOT (tên, giá, ảnh) → sửa giá SP không làm sai hoá đơn cũ
//   • Mọi truy vấn tiền & tồn kho phải nằm trong $transaction
// ════════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── ENUM ──────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PACKING
  SHIPPING
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  VNPAY
  MOMO
}

enum PaymentStatus {
  UNPAID
  PENDING_REVIEW
  PAID
  UNDERPAID
  FAILED
  REFUNDED
}

enum CouponType {
  PERCENT
  FIXED
}

enum DiscountTarget {
  ALL
  CATEGORY
  PRODUCT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  ORDER
  PAYMENT
  PROMOTION
  SYSTEM
  SECURITY
}

enum StockReason {
  PURCHASE
  ORDER_CANCELLED
  RESTOCK
  ADJUSTMENT
  RETURN
}

enum ShippingMethod {
  STANDARD
  EXPRESS
  INSTANT
}

// ──────────────────────────── NGƯỜI DÙNG ───────────────────────────────────

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String?
  fullName      String
  phone         String?
  avatarUrl     String?
  dateOfBirth   DateTime?  @db.Date
  gender        String?
  role          Role       @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)
  lastLoginAt   DateTime?
  lastLoginIp   String?
  deletedAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  addresses       Address[]
  orders          Order[]
  reviews         Review[]
  wishlist        WishlistItem[]
  cart            Cart?
  sessions        Session[]
  accounts        Account[]
  tokens          VerificationToken[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  couponUsages    CouponRedemption[]
  stockMovements  StockMovement[]
  productViews    ProductView[]

  @@index([role, status])
  @@index([createdAt])
  @@map("users")
}

/// Tài khoản mạng xã hội (Google, Facebook…) liên kết với user
model Account {
  id                String    @id @default(cuid())
  userId            String
  provider          String    // "google" | "facebook"
  providerAccountId String
  email             String?
  accessToken       String?   @db.Text
  refreshToken      String?   @db.Text
  expiresAt         Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Phiên đăng nhập — cơ sở cho refresh-token rotation & phát hiện tái sử dụng
model Session {
  id                  String    @id @default(cuid())
  userId              String
  tokenHash           String    @unique          // SHA-256(refresh token) — KHÔNG lưu bản thô
  family              String                      // nhóm token xoay vòng
  replacedBySessionId String?
  revokedAt           DateTime?
  revokedReason       String?
  userAgent           String?
  ip                  String?
  lastUsedAt          DateTime  @default(now())
  expiresAt           DateTime
  createdAt           DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([family])
  @@index([expiresAt])
  @@map("sessions")
}

/// Token dùng 1 lần: xác thực email & đặt lại mật khẩu
model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  type      TokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  fullName     String
  phone        String
  provinceCode String?
  provinceName String
  districtName String?
  wardName     String?
  detail       String   // số nhà, đường
  note         String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// ─────────────────────────────── DANH MỤC ──────────────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  imageUrl    String?
  iconName    String?
  parentId    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  metaTitle   String?
  metaDesc    String?   @db.Text
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]
  coupons  Coupon[]

  @@index([parentId, isActive])
  @@map("categories")
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  logoUrl     String?
  description String?   @db.Text
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]

  @@map("brands")
}

// ─────────────────────────────── SẢN PHẨM ──────────────────────────────────

model Product {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  sku            String    @unique
  shortDesc      String?
  description    String?   @db.Text
  specs          Json?     // { "Màn hình": "6.1 inch", ... }
  price          Decimal   @db.Decimal(12, 2)
  salePrice      Decimal?  @db.Decimal(12, 2)
  costPrice      Decimal?  @db.Decimal(12, 2)
  stock          Int       @default(0)   // tổng tồn (denormalized từ variants)
  lowStockAlert  Int       @default(5)
  sold           Int       @default(0)
  viewCount      Int       @default(0)
  weightGram     Int?
  warrantyMonths Int?
  tags           String[]
  isActive       Boolean   @default(true)
  isFeatured     Boolean   @default(false)
  categoryId     String
  brandId        String?
  metaTitle      String?
  metaDesc       String?   @db.Text
  publishedAt    DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  category   Category         @relation(fields: [categoryId], references: [id])
  brand      Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images     ProductImage[]
  variants   ProductVariant[]
  reviews    Review[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  wishlisted WishlistItem[]
  movements  StockMovement[]
  views      ProductView[]
  coupons    Coupon[]

  @@index([categoryId, isActive, deletedAt])
  @@index([brandId, isActive])
  @@index([isFeatured, isActive])
  @@index([salePrice])
  @@index([sold])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  thumbUrl  String?
  cardUrl   String?
  blurData  String? @db.Text   // base64 10px cho placeholder blur
  alt       String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  name       String   // "128GB / Đen"
  sku        String   @unique
  price      Decimal  @db.Decimal(12, 2)
  salePrice  Decimal? @db.Decimal(12, 2)
  stock      Int      @default(0)
  imageUrl   String?
  attributes Json?    // { "Dung lượng": "128GB", "Màu": "Đen" }
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]
  orderItems OrderItem[]

  @@index([productId, isActive])
  @@map("product_variants")
}

/// Ghi vết mọi biến động tồn kho (audit + debug oversell)
model StockMovement {
  id        String      @id @default(cuid())
  productId String
  variantId String?
  userId    String?
  change    Int         // âm = xuất, dương = nhập
  before    Int
  after     Int
  reason    StockReason
  reference String?     // orderCode / ghi chú
  createdAt DateTime    @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@map("stock_movements")
}

/// Lượt xem sản phẩm — nguồn cho "đã xem gần đây" + thống kê
model ProductView {
  id        String   @id @default(cuid())
  productId String
  userId    String?
  sessionId String?
  ip        String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([userId, createdAt])
  @@map("product_views")
}

// ─────────────────────────── GIỎ HÀNG / YÊU THÍCH ──────────────────────────

model Cart {
  id        String   @id @default(cuid())
  userId    String?  @unique
  guestId   String?  @unique   // cookie cartId cho khách chưa đăng nhập
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

// ─────────────────────────────── ĐƠN HÀNG ──────────────────────────────────

model Order {
  id              String        @id @default(cuid())
  orderCode       String        @unique   // DH26091400123 — dùng làm nội dung CK
  userId          String
  addressId       String?
  status          OrderStatus   @default(PENDING_PAYMENT)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(UNPAID)

  // snapshot địa chỉ giao hàng (địa chỉ gốc có thể bị sửa/xoá sau này)
  shippingAddress Json
  recipientName   String
  recipientPhone  String

  shippingMethod  ShippingMethod @default(STANDARD)
  subtotal        Decimal @db.Decimal(12, 2)
  shippingFee     Decimal @db.Decimal(12, 2) @default(0)
  discountAmount  Decimal @db.Decimal(12, 2) @default(0)
  totalAmount     Decimal @db.Decimal(12, 2)
  couponCode      String?

  note            String?  @db.Text
  cancelReason    String?  @db.Text
  trackingCode    String?

  confirmedAt DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  paymentDueAt DateTime?   // hạn thanh toán (24h) — cron dùng để huỷ đơn
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User                 @relation(fields: [userId], references: [id])
  address  Address?             @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  payment  Payment?
  history  OrderStatusHistory[]
  coupon   Coupon?              @relation(fields: [couponCode], references: [code], onDelete: SetNull)
  redemption CouponRedemption?

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([paymentStatus, paymentDueAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  productId     String
  variantId     String?
  // ── snapshot tại thời điểm mua ──
  productName   String
  variantName   String?
  productSlug   String
  sku           String
  imageUrl      String?
  unitPrice     Decimal @db.Decimal(12, 2)
  quantity      Int
  totalPrice    Decimal @db.Decimal(12, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?     @db.Text
  changedBy String?     // userId của admin/user thực hiện
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String        @unique
  method         PaymentMethod
  status         PaymentStatus @default(UNPAID)
  amount         Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @db.Decimal(12, 2) @default(0)
  transferCode   String        @unique              // mã đối soát, vd DH26091400123
  qrPayload      String?       @db.Text             // chuỗi EMVCo (đã có CRC)
  bankBin        String?
  bankAccountNo  String?
  bankAccountName String?
  gatewayRef     String?                            // mã giao dịch ngân hàng
  proofImageUrl  String?                            // ảnh bill khách/admin upload
  paidAt         DateTime?
  expiresAt      DateTime?
  rawWebhook     Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("payments")
}

/// Giao dịch ngân hàng không khớp đơn nào — admin xử lý thủ công
model UnmatchedTransaction {
  id          String   @id @default(cuid())
  bankRef     String?  @unique
  amount      Decimal  @db.Decimal(12, 2)
  content     String   @db.Text
  senderName  String?
  rawPayload  Json?
  resolved    Boolean  @default(false)
  note        String?
  createdAt   DateTime @default(now())

  @@index([resolved, createdAt])
  @@map("unmatched_transactions")
}

// ───────────────────────────── MÃ GIẢM GIÁ ────────────────────────────────

model Coupon {
  id             String         @id @default(cuid())
  code           String         @unique
  name           String
  description    String?        @db.Text
  type           CouponType
  value          Decimal        @db.Decimal(12, 2)
  minOrderValue  Decimal        @db.Decimal(12, 2) @default(0)
  maxDiscount    Decimal?       @db.Decimal(12, 2)
  usageLimit     Int?           // tổng số lượt
  usageLimitPerUser Int?        @default(1)
  usedCount      Int            @default(0)
  startsAt       DateTime       @default(now())
  expiresAt      DateTime?
  target         DiscountTarget @default(ALL)
  categoryId     String?
  productId      String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  category    Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  product     Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  redemptions CouponRedemption[]
  orders      Order[]

  @@index([isActive, expiresAt])
  @@map("coupons")
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  code      String
  userId    String
  orderId   String   @unique
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

// ─────────────────────────────── ĐÁNH GIÁ ──────────────────────────────────

model Review {
  id         String       @id @default(cuid())
  productId  String
  userId     String
  orderId    String?
  rating     Int          // 1..5
  title      String?
  content    String       @db.Text
  images     String[]
  status     ReviewStatus @default(PENDING)
  isVerified Boolean      @default(true)   // đã mua thật
  helpfulCount Int        @default(0)
  adminReply String?      @db.Text
  repliedAt  DateTime?
  deletedAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId, status])
  @@map("reviews")
}

// ─────────────────────────── THÔNG BÁO / AUDIT / CẤU HÌNH ──────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  body      String?          @db.Text
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // "product.create" | "order.status_update" | "user.block" …
  entity     String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

/// Cấu hình shop do admin chỉnh (1 dòng duy nhất, key = "default")
model SiteSetting {
  id           String   @id @default("default")
  siteName     String   @default("ShopVN")
  logoUrl      String?
  hotline      String?
  email        String?
  address      String?
  taxCode      String?
  social       Json?    // { facebook, instagram, tiktok, youtube, zalo }
  bankBin         String?
  bankAccountNo   String?
  bankAccountName String?
  bankName        String?
  shippingFees Json?    // { STANDARD: 30000, EXPRESS: 50000, INSTANT: 80000 }
  freeShipThreshold Decimal? @db.Decimal(12, 2)
  seoTitle     String?
  seoDesc      String?  @db.Text
  maintenance  Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  @@map("site_settings")
}
