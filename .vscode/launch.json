{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: chạy & debug API (tsx)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "đang chạy tại http://localhost:([0-9]+)",
        "uriFormat": "http://localhost:%s/api/docs"
      }
    },
    {
      "name": "Backend: gắn vào tiến trình đang chạy (:9229)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "localRoot": "${workspaceFolder}/backend",
      "remoteRoot": "${workspaceFolder}/backend"
    },
    {
      "name": "Frontend: chạy Next.js (server)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "Local:\\s+http://localhost:([0-9]+)",
        "uriFormat": "http://localhost:%s"
      }
    },
    {
      "name": "Frontend: mở Chrome ở :3000",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/frontend/src"
    },
    {
      "name": "Frontend: gắn Chrome đang mở (--remote-debugging-port=9222)",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/frontend/src"
    }
  ],
  "compounds": [
    {
      "name": "Full stack: API + Web",
      "configurations": ["Backend: chạy & debug API (tsx)", "Frontend: chạy Next.js (server)"],
      "stopAll": true
    }
  ]
}
